# Code-Mem optional runtime settings.
# Code-Mem does not require a .env file. Harness settings remain the source of
# truth for LLM access; cm inherits the harness environment when it runs.

# Local graph service port (default: 4804).
# CM_GRAPH_SERVICE_PORT=4804

# Optional local import model. Used only when the configured harness/provider
# cannot perform bounded import normalization.
# CM_IMPORT_MODEL=your-local-model

# Deterministic, non-LLM imports/tests.
# CM_IMPORT_NO_LLM=1

# Deterministic test/debug mode: disable optional LLM and Ollama integrations.
# CM_NO_LLM=1
# CM_NO_OLLAMA=1

# Optional Ollama endpoint/model for embeddings.
# OLLAMA_BASE_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text

# Optional Jev (TypeSafe AI) typed-decision classifier. Prefer storing the key
# with `cm config set TYPESAFE_API_KEY` (masked, mode 600) over this file.
# TYPESAFE_API_KEY=
# CM_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# CM_JEV_MODEL=jev-latest
# CM_JEV=off
# CM_NO_NOTIFY=1
