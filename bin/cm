    "code-file": "#c4b5fd", file: "#c4b5fd", function: "#fda4af", class: "#fb7185", module: "#f0abfc",
    configuration: "#fde68a", technology: "#86efac", asset: "#fdba74", default: "#94a3b8",
  };
  const html = `<!doctype html>
